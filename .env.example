# CognoDB Connection (via Neo4j Bolt protocol)
COGNODB_URI=bolt+s://your-instance.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-password-here

# Backend server port
PORT=3001

# Optional comma-separated allowed CORS origins (empty = allow any, dev default)
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Frontend API URL (set in frontend/.env)
# VITE_API_URL=http://localhost:3001
